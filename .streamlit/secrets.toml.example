# =======================================================
# Streamlit secrets for Investor Outreach Dashboard
# Copy this file to .streamlit/secrets.toml and fill in
# your real credentials.
# =======================================================

# ------ Test recipient (receives "Send Test Email") ------
TEST_EMAIL = "your-test@example.com"

# ------ Hunter.io API (optional, for email enrichment) ------
# HUNTER_API_KEY = "your_hunter_api_key_here"

# =======================================================
# SMTP Sender Accounts
# =======================================================
# Add one [[SENDER_ACCOUNTS]] block per sending address.
# You can have as many as you need — when there are 2+,
# the Email Outreach page shows a dropdown to pick which
# account sends.
#
# For Gmail, use an App Password (not your login password):
#   https://support.google.com/accounts/answer/185833

[[SENDER_ACCOUNTS]]
label = "Your Name"
smtp_server = "smtp.gmail.com"
smtp_port = 587
email = "you@dealflow.sg"
password = "xxxx-xxxx-xxxx-xxxx"

# [[SENDER_ACCOUNTS]]
# label = "Another Sender"
# smtp_server = "smtp.gmail.com"
# smtp_port = 587
# email = "another@dealflow.sg"
# password = "yyyy-yyyy-yyyy-yyyy"

# =======================================================
# Legacy flat format (still works if SENDER_ACCOUNTS is
# not present — kept here for reference only):
# =======================================================
# SMTP_SERVER = "smtp.gmail.com"
# SMTP_PORT = 587
# SENDER_EMAIL = "you@dealflow.sg"
# SENDER_PASSWORD = "xxxx-xxxx-xxxx-xxxx"
